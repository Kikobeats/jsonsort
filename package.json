{
  "name": "@kikobeats/jsonsort",
  "description": "Sort a JSON object or collection of objects by a criteria path for stable, readable output.",
  "homepage": "https://github.com/Kikobeats/jsonsort",
  "version": "1.3.22",
  "main": "index.js",
  "bin": {
    "jsonsort": "bin/index.js"
  },
  "author": {
    "email": "josefrancisco.verdu@gmail.com",
    "name": "Kiko Beats",
    "url": "https://kikobeats.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kikobeats/jsonsort.git"
  },
  "bugs": {
    "url": "https://github.com/Kikobeats/jsonsort/issues"
  },
  "keywords": [
    "array",
    "collection",
    "compare",
    "criteria",
    "deep",
    "json",
    "object",
    "order",
    "sort",
    "stable"
  ],
  "dependencies": {
    "beauty-error": "~1.2.9",
    "es6-arrow-function": "~0.6.6",
    "get-stdin": "~8.0.0",
    "json-future": "~2.2.14",
    "meow": "~9.0.0",
    "sort-keys": "~4.2.0",
    "sort-on": "~4.1.0",
    "update-notifier": "~5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "ci-publish": "latest",
    "finepack": "latest",
    "git-authors-cli": "latest",
    "github-generate-release": "latest",
    "nano-staged": "latest",
    "simple-git-hooks": "latest",
    "standard": "latest",
    "standard-markdown": "latest",
    "standard-version": "latest"
  },
  "engines": {
    "node": ">= 8"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "clean": "rm -rf node_modules",
    "contributors": "(npx git-authors-cli && npx finepack && git add package.json && git commit -m 'build: contributors' --no-verify) || true",
    "lint": "standard-markdown README.md && standard",
    "postrelease": "npm run release:tags && npm run release:github && (ci-publish || npm publish --access=public)",
    "prerelease": "npm run contributors",
    "pretest": "npm run lint",
    "pretty": "prettier-standard index.js {core,test,bin,scripts}/**/*.js --single-quote --print-width 100",
    "release": "standard-version -a",
    "release:github": "github-generate-release",
    "release:tags": "git push --follow-tags origin HEAD:master",
    "test": "exit 0"
  },
  "preferGlobal": true,
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "nano-staged": {
    "*.js": [
      "npx @kikobeats/prettier-standard",
      "standard --fix"
    ],
    "*.md": [
      "standard-markdown"
    ],
    "package.json": [
      "finepack"
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit",
    "pre-commit": "npx nano-staged"
  }
}
